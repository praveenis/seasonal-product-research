{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sbrp.app/schemas/affiliate-page-package.schema.json",
  "title": "SBRP affiliate page package",
  "description": "Owner-supplied evidence and approval record for an affiliate comparison page. This package does not publish by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "draft_id", "workflow_state", "created_at", "topic",
    "primary_query", "search_intent", "audience", "market", "retailer", "affiliate_program", "affiliate_links_authorized",
    "minimum_review_count", "ranking_method", "page_title", "slug", "summary", "intro",
    "methodology", "limitations", "recommendations", "excluded_candidates", "approval"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "draft_id": { "type": "string", "format": "uuid" },
    "workflow_state": { "enum": ["pending_review", "revision_requested", "rejected", "approved"] },
    "created_at": { "type": "string", "format": "date-time" },
    "topic": { "type": "string", "minLength": 1 },
    "primary_query": { "type": "string", "minLength": 1 },
    "search_intent": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "market": { "type": "string", "minLength": 1 },
    "retailer": { "type": "string", "minLength": 1 },
    "affiliate_program": { "type": ["string", "null"] },
    "affiliate_links_authorized": { "type": "boolean" },
    "minimum_review_count": { "type": "integer", "minimum": 0 },
    "ranking_method": { "type": "string", "minLength": 1 },
    "page_title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 220 },
    "intro": { "type": "string", "minLength": 1 },
    "methodology": { "type": "string", "minLength": 1 },
    "limitations": { "type": "string", "minLength": 1 },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "brand", "product_name", "model", "why_consider", "considerations", "retailer", "market", "rating",
          "rating_max", "review_count", "source_url", "checked_on", "affiliate_url",
          "evidence_status", "rank"
        ],
        "properties": {
          "brand": { "type": "string", "minLength": 1 },
          "product_name": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "why_consider": { "type": "string", "minLength": 1 },
          "considerations": { "type": "string" },
          "retailer": { "type": "string", "minLength": 1 },
          "market": { "type": "string", "minLength": 1 },
          "rating": { "type": "number", "minimum": 0 },
          "rating_max": { "type": "number", "exclusiveMinimum": 0 },
          "review_count": { "type": "integer", "minimum": 1 },
          "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "checked_on": { "type": "string", "format": "date" },
          "affiliate_url": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "format": "uri", "pattern": "^https://" }
            ]
          },
          "evidence_status": { "const": "owner_supplied_not_independently_verified" },
          "rank": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    },
    "excluded_candidates": { "type": "array", "items": { "type": "string" } },
    "approval": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "reviewer", "decided_at", "notes"],
          "properties": {
            "decision": { "enum": ["approved", "rejected", "revision_requested"] },
            "reviewer": { "type": "string", "minLength": 1 },
            "decided_at": { "type": "string", "format": "date-time" },
            "notes": { "type": "string" },
            "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "workflow_state": { "const": "approved" } },
        "required": ["workflow_state"]
      },
      "then": {
        "properties": {
          "approval": {
            "type": "object",
            "required": ["content_sha256"]
          }
        }
      }
    }
  ]
}
